# Local development only. Use a dedicated PostgreSQL database for each developer.
DATABASE_URL=postgresql://accessloop:accessloop@127.0.0.1:5432/accessloop
# Generate separate stable secrets, for example: openssl rand -hex 32
PAYLOAD_SECRET=
SESSION_SECRET=
APP_BASE_URL=http://localhost:3000
APP_MODE=demo

# Bootstrap credentials: pnpm admin:bootstrap or the one-shot Zenith initializer; never NEXT_PUBLIC_.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# D supplies the measured region and initial passage data in the next stage.
REGION_ID=region-unsw
REGION_BBOX=
PERSONAL_AVOIDANCE_TTL_SECONDS=3600
PUBLIC_HAZARD_TTL_SECONDS=86400
# Exact approved private evidence references; an empty list still permits field observations.
TRUSTED_MAINTAINER_REFERENCES=[]

# C connects private OSS storage; production startup requires these settings.
OSS_ENDPOINT=
OSS_BUCKET=
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SIGNED_URL_TTL_SECONDS=300

# Server-only provider settings; actual integrations belong to C/D.
ORS_API_KEY=
ORS_BASE_URL=https://api.heigit.org/openrouteservice
POI_PROVIDER=overpass
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
# Used only when POI_PROVIDER=heigit; both sources retain OpenStreetMap attribution.
POI_BASE_URL=https://api.heigit.org/openpoiservice/v0
POI_RPM=10
POI_DAILY_BUDGET=450
ORS_RPM=30
ORS_DAILY_BUDGET=1800
GEOCODING_BASE_URL=https://api.heigit.org/pelias/v1
GEOCODING_RPM=60
GEOCODING_DAILY_BUDGET=2500
VISION_PROVIDER=glm
# Paid GLM-4.6V; existing standard API key and persistent Vision budget still apply.
VISION_MODEL=glm-4.6v
VISION_API_KEY=
VISION_SCHEMA_VERSION=1
VISION_PROMPT_VERSION=1
VISION_TIMEOUT_MS=8000
# Positive integer daily cap; literal unlimited disables only the application daily cap.
# Provider limits and the separate per-minute cap still apply.
VISION_RPM=10
VISION_DAILY_BUDGET=
# Supplemental facilities; token is server-only. Public datasets/declared license IDs are explicit allowlists.
ACCESSIBILITY_CLOUD_APP_TOKEN=
ACCESSIBILITY_CLOUD_SOURCE_IDS=["BBQwnkLokb9xADdNK","LiBTS67TjmBcXdEmX"]
ACCESSIBILITY_CLOUD_LICENSE_IDS=["HX7tNmswKFQxMtBji","R6Lneq4ZL2uMausHZ"]
# Only these map settings are public. Custom HTTPS XYZ tiles require their own attribution.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors
MAP_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright

# Zenith-only private deployment inputs; see docs/deployment/zenith-preview.md.
# POSTGRES_PASSWORD= (must match the password in the internal DATABASE_URL)
# PROVIDER_LEDGER_SNAPSHOT= (bounded one-off transfer via C; never commit its value)
