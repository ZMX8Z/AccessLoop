{
  "name": "accessloop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": "22.14.0",
    "pnpm": "10.20.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "prestart": "tsx scripts/check-environment.ts",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "db:migrate:create": "payload migrate:create",
    "db:migrate": "payload migrate",
    "db:migrate:status": "payload migrate:status",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "deploy:probe": "tsx scripts/deployment-probe.ts"
  },
  "dependencies": {
    "@next/env": "16.3.3",
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/storage-s3": "3.91.0",
    "@payloadcms/translations": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "@turf/area": "7.3.1",
    "@turf/buffer": "7.3.1",
    "@turf/helpers": "7.3.1",
    "@turf/union": "7.3.1",
    "graphql": "16.11.0",
    "next": "16.3.3",
    "payload": "3.91.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.14.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
